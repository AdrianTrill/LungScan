# Copy to backend/.env to override the defaults.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Where patients, cases, results, and uploads are kept.
# LUNGSCAN_DATA_DIR=./data
# LUNGSCAN_UPLOAD_DIR=./uploads

# Start with the sample slices when the data directory is empty.
# LUNGSCAN_SEED_SAMPLES=true

# The exported model, and where to download it from when it is missing.
# LUNGSCAN_MODEL_PATH=../model/lungscan.onnx
# LUNGSCAN_MODEL_URL=https://adriantrill.github.io/LungScan/models/lungscan.onnx
