import os
import torch
import torch.cuda.amp as amp
import config as cfg
from dataset import get_dataloaders
from model import get_vista_model

from monai.metrics import compute_dice
from monai.losses import DiceLoss
from monai.inferers import sliding_window_inference
from monai.apps.vista3d.sampler import sample_prompt_pairs
from monai.apps.vista3d.transforms import VistaPostTransformd

def main():
    os.makedirs(cfg.CHECKPOINT_DIR, exist_ok=True)
    os.makedirs(cfg.LOG_DIR, exist_ok=True)
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    
    train_loader, val_loader = get_dataloaders()
    model = get_vista_model(load_weights=True).to(device)
    
    loss_function = DiceLoss(to_onehot_y=False, sigmoid=True) 
    
    # CHANGED: Use standard Adam to match official VISTA finetuning recipe
    optimizer = torch.optim.Adam(model.parameters(), lr=cfg.LR)
    
    scaler = amp.GradScaler()
    
    # Training Config
    max_point = 5
    max_prompt = 32
    max_backprompt = 4
    drop_label_prob = 0.2
    drop_point_prob = 0.5 
    
    best_metric = -1
    best_metric_epoch = -1

    print(f"--- Training Started | Simulated Batch Size: {cfg.BATCH_SIZE} | LR: {cfg.LR} ---")
    
    for epoch in range(cfg.MAX_EPOCHS):
        model.train()
        epoch_loss = 0
        step = 0
        
        for batch_data in train_loader:
            step += 1
            inputs_all = batch_data["image"].to(device)
            labels_all = batch_data["label"].to(device)
            
            optimizer.zero_grad()
            batch_loss_accumulator = 0.0
            
            # Virtual Batch Loop
            for i in range(labels_all.shape[0]):
                inputs = inputs_all[[i]]
                labels = labels_all[[i]]
                
                label_prompt, point, point_label, prompt_class = sample_prompt_pairs(
                    labels,
                    cfg.LABEL_SET,
                    max_point=max_point,
                    max_prompt=max_prompt,
                    max_backprompt=max_backprompt,
                    max_foreprompt=None,
                    drop_label_prob=drop_label_prob,
                    drop_point_prob=drop_point_prob,
                )
                
                if prompt_class is None: 
                    continue

                with amp.autocast():
                    outputs = model(
                        input_images=inputs, 
                        point_coords=point, 
                        point_labels=point_label, 
                        class_vector=label_prompt
                    )
                    
                    loss = torch.tensor(0.0, device=device)
                    loss_n = torch.tensor(0.0, device=device)
                    
                    for id in range(len(prompt_class)):
                        # FIX: Cast target to float explicitly for stability
                        target = (labels == prompt_class[id]).float()
                        
                        loss += loss_function(outputs[[id]].float(), target)
                        loss_n += 1.0
                    
                    loss /= max(loss_n, 1.0)
                    loss = loss / labels_all.shape[0] # Normalize for accumulation

                scaler.scale(loss).backward()
                batch_loss_accumulator += loss.item() * labels_all.shape[0]
            
            # FIX: Gradient Clipping to prevent NaN
            scaler.unscale_(optimizer)
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
            
            scaler.step(optimizer)
            scaler.update()
                
            epoch_loss += batch_loss_accumulator

            if step % 20 == 0:
                print(f"  Ep {epoch+1} [{step}/{len(train_loader)}] Loss: {batch_loss_accumulator:.4f}")

        epoch_loss /= step
        print(f"Ep {epoch+1} Avg Loss: {epoch_loss:.4f}")

        # --- VALIDATION ---
        if (epoch + 1) % cfg.VAL_INTERVAL == 0:
            model.eval()
            dice_scores = []
            target_class_tensor = torch.tensor([cfg.TARGET_VISTA_CLASS], device=device)
            
            # Monitoring model collapse
            total_pred_pixels = 0 

            with torch.no_grad():
                for val_data in val_loader:
                    val_inputs = val_data["image"].to(device)
                    val_labels = val_data["label"].to(device)
                    
                    with amp.autocast():
                        val_outputs = sliding_window_inference(
                            inputs=val_inputs,
                            roi_size=cfg.INPUT_SHAPE,
                            sw_batch_size=4,
                            predictor=model,
                            overlap=0.25, 
                            transpose=True, 
                            class_vector=target_class_tensor
                        )
                    
                    post_pred = VistaPostTransformd(keys="pred")(
                        {"pred": val_outputs, "label_prompt": target_class_tensor}
                    )["pred"]
                    
                    pred_binary = (post_pred.unsqueeze(0) == cfg.TARGET_VISTA_CLASS).float()
                    label_binary = (val_labels == cfg.TARGET_VISTA_CLASS).float()
                    
                    total_pred_pixels += pred_binary.sum().item()

                    # Handle Empty GT (True Negatives)
                    if label_binary.sum() == 0:
                        if pred_binary.sum() == 0:
                            dice_item = 1.0 
                        else:
                            dice_item = 0.0 
                    else:
                        dice = compute_dice(
                            y_pred=pred_binary, 
                            y=label_binary, 
                            include_background=False
                        )
                        dice_item = dice.item()

                    if dice_item != dice_item: # Check NaN
                        dice_item = 0.0
                        
                    dice_scores.append(dice_item)
            
            if len(dice_scores) > 0:
                mean_dice = sum(dice_scores) / len(dice_scores)
                # This log helps you see if model is dead (Pred Sum = 0)
                print(f"Ep {epoch+1} Val Dice: {mean_dice:.4f} | Total Pred Pixels: {int(total_pred_pixels)}")
                
                if mean_dice > best_metric:
                    best_metric = mean_dice
                    best_metric_epoch = epoch + 1
                    torch.save(model.state_dict(), os.path.join(cfg.CHECKPOINT_DIR, "best_model.pth"))
                    print(f"  >>> New Best Model (Dice: {best_metric:.4f})")

    print(f"Done. Best Dice: {best_metric:.4f} at Epoch {best_metric_epoch}")

if __name__ == "__main__":
    main()======================================================

import os
import torch
import numpy as np
from tqdm import tqdm
from monai.metrics import DiceMetric, HausdorffDistanceMetric
from monai.inferers import sliding_window_inference
from monai.apps.vista3d.transforms import VistaPostTransformd
import config as cfg
from dataset import get_dataloaders
from model import get_vista_model

def evaluate():
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"[Eval] Device: {device}")

    # We only need the validation/test loader here
    _, val_loader = get_dataloaders()
    model = get_vista_model(load_weights=False).to(device)
    
    weight_path = os.path.join(cfg.CHECKPOINT_DIR, "best_model.pth")
    if os.path.exists(weight_path):
        model.load_state_dict(torch.load(weight_path, map_location=device))
        print(f"[Eval] Loaded weights from {weight_path}")
    else:
        print(f"[Error] No weights found at {weight_path}")
        return

    model.eval()

    dice_metric = DiceMetric(include_background=False, reduction="mean")
    hd95_metric = HausdorffDistanceMetric(include_background=False, percentile=95, reduction="mean")

    target_class_tensor = torch.tensor([cfg.TARGET_VISTA_CLASS], device=device)

    print("[Eval] Starting inference...")
    
    with torch.no_grad():
        for test_data in tqdm(val_loader):
            inputs = test_data["image"].to(device)
            labels = test_data["label"].to(device)
            
            with torch.cuda.amp.autocast():
                outputs = sliding_window_inference(
                    inputs=inputs,
                    roi_size=cfg.INPUT_SHAPE,
                    sw_batch_size=4,
                    predictor=model,
                    overlap=0.5, 
                    transpose=True,
                    class_vector=target_class_tensor 
                )
            
            # Post-process: Converts raw model output to class indices
            post_pred = VistaPostTransformd(keys="pred")(
                {"pred": outputs, "label_prompt": target_class_tensor}
            )["pred"]
            
            # Binarize: Check if predicted class index matches Target Class
            pred_binary = (post_pred.unsqueeze(0) == cfg.TARGET_VISTA_CLASS).float()
            label_binary = (labels == cfg.TARGET_VISTA_CLASS).float()
            
            dice_metric(y_pred=pred_binary, y=label_binary)
            hd95_metric(y_pred=pred_binary, y=label_binary)

    print("\n=========================================")
    print(f" RESULTS FOR VISTA-3D (Virtual Biopsy)")
    print("=========================================")
    # Aggregate returns a tensor, .item() gets the float value
    print(f" NODULE DICE: {dice_metric.aggregate().item():.4f}")
    print(f" HD95 (mm):   {hd95_metric.aggregate().item():.4f}")
    print("=========================================")

if __name__ == "__main__":
    evaluate()import os
import glob
import torch
import warnings
from torch.utils.data import Dataset, DataLoader
from sklearn.model_selection import train_test_split
from monai.transforms import (
    Compose, LoadImaged, EnsureChannelFirstd, RandFlipd, 
    RandRotate90d, RandShiftIntensityd, EnsureTyped,
    RandCropByPosNegLabeld
)
from monai.apps.vista3d.transforms import Relabeld
import config as cfg

warnings.filterwarnings("ignore")

class SingleCropByPosNegLabeld(RandCropByPosNegLabeld):
    """
    MONAI's RandCropByPosNegLabeld returns a LIST of crops (even if num_samples=1).
    This wrapper extracts the single item so PyTorch DataLoaders receive a Tensor, not a List.
    """
    def __call__(self, data, **kwargs):
        results = super().__call__(data, **kwargs)
        if isinstance(results, list) and len(results) > 0:
            return results[0]
        return results

class LidcDataset(Dataset):
    def __init__(self, file_list, transforms=None):
        self.files = file_list
        self.transforms = transforms

    def __len__(self):
        return len(self.files)

    def __getitem__(self, idx):
        img_path, mask_path = self.files[idx]
        data = {"image": img_path, "label": mask_path}
        if self.transforms:
            try:
                data = self.transforms(data)
            except Exception as e:
                print(f"[Dataset] Error processing {img_path}: {e}")
                raise e
        return data

def get_transforms(mode="train"):
    # Base transforms
    base_transforms = [
        LoadImaged(keys=["image", "label"], ensure_channel_first=False),
        EnsureChannelFirstd(keys=["image", "label"], channel_dim=0),
        
        # --- CRITICAL FIX: Ensure Label is Integer for Relabeld ---
        # Since preprocess.py saved them as floats, we must cast here.
        EnsureTyped(keys=["label"], dtype=torch.int64),
        
        # Map original Mask ID (1) to VISTA Target ID (23)
        Relabeld(keys="label", label_mappings=cfg.LABEL_MAPPINGS, dtype=torch.uint8), 
    ]
    
    if mode == "train":
        augments = [
            SingleCropByPosNegLabeld(
                keys=["image", "label"], label_key="label",
                spatial_size=cfg.INPUT_SHAPE,
                pos=1.0, 
                neg=0.5, # Increased slightly to 0.5 to show *some* negatives during training
                num_samples=1, 
                image_key="image", image_threshold=0,
            ),
            RandRotate90d(keys=["image", "label"], prob=0.5, spatial_axes=(0, 1)),
            RandFlipd(keys=["image", "label"], prob=0.5, spatial_axis=0),
            RandFlipd(keys=["image", "label"], prob=0.5, spatial_axis=1),
            RandFlipd(keys=["image", "label"], prob=0.5, spatial_axis=2),
            RandShiftIntensityd(keys=["image"], offsets=0.1, prob=0.2),
            EnsureTyped(keys=["image", "label"]),
        ]
        return Compose(base_transforms + augments)
    else:
        # Validation: No cropping, full volume evaluation
        return Compose(base_transforms + [EnsureTyped(keys=["image", "label"])])

def get_dataloaders():
    print(f"[Data] Scanning {cfg.IMG_DIR}...")
    all_images = sorted(glob.glob(os.path.join(cfg.IMG_DIR, "*.npy")))
    
    if len(all_images) == 0:
        raise ValueError(f"No .npy files found in {cfg.IMG_DIR}. Did preprocessing run?")

    patient_map = {}
    for img_path in all_images:
        filename = os.path.basename(img_path)
        # Parse patient ID to prevent data leakage across splits
        pid = "_".join(filename.split("_")[:-1]) 
        mask_path = os.path.join(cfg.MASK_DIR, filename)
        
        if os.path.exists(mask_path):
            if pid not in patient_map: patient_map[pid] = []
            patient_map[pid].append((img_path, mask_path))

    pids = sorted(list(patient_map.keys()))
    
    # Stratified Split (Patient Level)
    train_pids, temp = train_test_split(pids, train_size=0.8, random_state=42)
    val_pids, test_pids = train_test_split(temp, test_size=0.5, random_state=42)

    flatten = lambda plist: [f for pid in plist for f in patient_map[pid]]
    train_files, val_files = flatten(train_pids), flatten(val_pids)

    print(f"[Data] Train Patches: {len(train_files)} | Val Patches: {len(val_files)}")

    train_loader = DataLoader(
        LidcDataset(train_files, transforms=get_transforms("train")), 
        batch_size=cfg.BATCH_SIZE, 
        shuffle=True, 
        num_workers=cfg.NUM_WORKERS, 
        pin_memory=True, 
        drop_last=True
    )
    
    val_loader = DataLoader(
        LidcDataset(val_files, transforms=get_transforms("val")), 
        batch_size=1, # Validation must be 1 for Sliding Window
        shuffle=False, 
        num_workers=cfg.NUM_WORKERS, 
        pin_memory=True
    )

    return train_loader, val_loaderimport os
