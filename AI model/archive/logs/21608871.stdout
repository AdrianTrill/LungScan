DICOM_DIR = os.path.join(PROJECT_ROOT, "LIDC-IDRI")

# 2. Output Data Root
OUTPUT_ROOT = "/shares/CC_v_Val_FV_Gen3_all/VIDT_DL/data/cnn_training/projects/smart_data_selection/town_signs/preprocessed_output/"
