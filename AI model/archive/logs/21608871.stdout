import torch
import torch.nn as nn
import os
import config as cfg

# Import strictly from standard MONAI paths or fallback
try:
    from monai.networks.nets import vista3d132
except ImportError:
    from scripts.modeling.vista3d import vista3d132

def get_vista_model(load_weights=True):
    """
    Returns the full VISTA-3D architecture (132 classes).
    We do NOT replace the head. We use prompt-based fine-tuning.
    """
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    
    # 1. Instantiate Official Model
    print(f"[Model] Initializing VISTA-3D (132 Classes)...")
    model = vista3d132(encoder_embed_dim=48, in_channels=1)
    
    # 2. Load Weights
    if load_weights:
        if not os.path.exists(cfg.PRETRAINED_CHECKPOINT):
            print(f"[WARNING] Checkpoint not found at {cfg.PRETRAINED_CHECKPOINT}")
        else:
            print(f"[Model] Loading weights from {cfg.PRETRAINED_CHECKPOINT}...")
            # weights_only=True is safer and recommended by PyTorch/MONAI now
            try:
                state_dict = torch.load(cfg.PRETRAINED_CHECKPOINT, map_location="cpu", weights_only=True)
                model.load_state_dict(state_dict)
                print("[Model] Weights loaded successfully.")
            except Exception as e:
                print(f"[ERROR] Weight load failed: {e}")
                
    return model======================================================

