LABEL_SET = [0, TARGET_VISTA_CLASS] 

# --- HYPERPARAMETERS ---
BATCH_SIZE = 4  
NUM_WORKERS = 8 

# STRICT ALIGNMENT WITH OFFICIAL RECIPE
LR = 1e-5         # Lowered from 1e-4 to prevent NaN/Collapse
