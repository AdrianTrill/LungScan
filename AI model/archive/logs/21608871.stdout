# --- SETUP PYLIDC AUTOMATICALLY ---
def setup_pylidc_config():
    """Generates a local .pylidcrc file pointing to your dataset."""
    if not os.path.exists(DICOM_DIR):
        raise FileNotFoundError(f"CRITICAL: DICOM directory not found at {DICOM_DIR}")

    config = configparser.ConfigParser()
    config['dicom'] = {
        'path': DICOM_DIR,
        'warn_improper_ct_image': 'true'
    }
    # We use a local SQLite db file inside the project root to avoid home dir issues
    db_path = os.path.join(PROJECT_ROOT, "pylidc.db")
    config['database'] = {
        'path': db_path
    }

    with open(PYLIDC_CFG_PATH, 'w') as configfile:
        config.write(configfile)
    
    print(f"--- Pylidc Configuration Generated ---")
    print(f"Config File: {PYLIDC_CFG_PATH}")
    print(f"DICOM Path:  {DICOM_DIR}")
    print(f"DB Path:     {db_path}")
    print(f"------------------------------------")

# Run setup BEFORE importing pylidc
setup_pylidc_config()

import pylidc as pl
import torch
import torch.nn.functional as F
import torch.multiprocessing as mp
from tqdm import tqdm
import random
import queue

# --- PROCESSING CONFIGURATION ---
TARGET_SPACING = (1.0, 1.0, 1.0)
CUBE_SIZE = (192, 192, 192)
STRIDE = (96, 96, 96)
LUNG_WINDOW = [-1000, 400]
NUM_WORKERS = 12 
# ---------------------

def create_consensus_mask_cpu(scan_id, vol_shape):
    """
    Worker function to generate mask. 
    """
    # Re-query inside worker to avoid pickle issues
    scan = pl.query(pl.Scan).filter(pl.Scan.id == scan_id).first()
    mask = np.zeros(vol_shape, dtype=np.uint8) 
    
    try:
        annotation_clusters = scan.cluster_annotations()
        if not annotation_clusters: return mask
        
        for ann_cluster in annotation_clusters:
            for ann in ann_cluster:
                try:
                    cropped_mask = ann.boolean_mask()
                    slices = ann.bbox()
                    
                    mask_slice_view = mask[slices]
                    
                    # Handle boundary/shape mismatch edge cases
                    if mask_slice_view.shape == cropped_mask.shape:
                        combined = (mask_slice_view > 0) | cropped_mask
                        mask[slices] = combined.astype(np.uint8)
                    else:
                        s_shape = mask_slice_view.shape
                        cropped_mask_view = cropped_mask[:s_shape[0], :s_shape[1], :s_shape[2]]
                        combined = (mask_slice_view > 0) | cropped_mask_view
                        mask[slices] = combined.astype(np.uint8)
                except: continue
    except: pass
    return mask

def worker_producer(worker_id, scan_ids_queue, data_queue):
    """
    CPU Worker: Loads DICOMs, Generates Masks, Pushes to Queue.
    """
    warnings.filterwarnings("ignore")
    
    # Reload config in worker process to ensure DB connection works
    os.environ["PYLIDCRC"] = PYLIDC_CFG_PATH
    
    while True:
        try:
            scan_id = scan_ids_queue.get(timeout=5)
        except queue.Empty:
            break
            
        try:
            scan = pl.query(pl.Scan).filter(pl.Scan.id == scan_id).first()
            patient_id = scan.patient_id
            
            # CPU Heavy IO
            ct_vol = scan.to_volume(verbose=False)
            current_spacing = (scan.slice_spacing, scan.pixel_spacing, scan.pixel_spacing)
            mask_vol = create_consensus_mask_cpu(scan_id, ct_vol.shape)
            
            # Push to GPU Consumer
            data_queue.put((patient_id, ct_vol, mask_vol, current_spacing))
            
        except Exception as e:
            # Skip failed scans (e.g., corrupt DICOM) without crashing
            pass
            
    data_queue.put(None) # Signal finished

def gpu_resample(tensor, current_spacing, target_spacing, mode='trilinear'):
    """
    H100 GPU Interpolation
    """
    if current_spacing == target_spacing: return tensor
    
    # Convert numpy/list to tensor for calculation if necessary
    scale_factor = [c / t for c, t in zip(current_spacing, target_spacing)]
    
    new_depth = int(tensor.shape[0] * scale_factor[0])
    new_height = int(tensor.shape[1] * scale_factor[1])
    new_width = int(tensor.shape[2] * scale_factor[2])
    
    # Add batch/channel dims for interpolate: (1, 1, D, H, W)
    tensor = tensor.unsqueeze(0).unsqueeze(0)
    
    # Use float32 for geometric precision
    with torch.amp.autocast('cuda', enabled=False):
        tensor = F.interpolate(
            tensor.float(), 
            size=(new_depth, new_height, new_width), 
            mode=mode, 
            align_corners=False if mode != 'nearest' else None
        )
        
    return tensor.squeeze(0).squeeze(0)

def main():
    # Set start method to spawn for CUDA compatibility
    mp.set_start_method('spawn', force=True)
    
    print(f"--- SOTA Preprocessing Started ---")
    
    os.makedirs(IMG_DIR, exist_ok=True)
    os.makedirs(MASK_DIR, exist_ok=True)
    
    device = torch.device("cuda")
    print(f"Using Device: {device}")
    print(f"Saving to: {OUTPUT_ROOT}")
    
    # 1. Setup Queue
    print("Querying LIDC-IDRI DB...")
    scans = pl.query(pl.Scan).all()
    all_scan_ids = [s.id for s in scans]
    total_scans = len(all_scan_ids)
    print(f"Found {total_scans} scans.")
    
    scan_ids_queue = mp.Queue()
    data_queue = mp.Queue(maxsize=8) # Keep RAM usage controlled
    
    for sid in all_scan_ids:
        scan_ids_queue.put(sid)

    # 2. Launch Workers
    print(f"Launching {NUM_WORKERS} CPU workers...")
    processes = []
    for i in range(NUM_WORKERS):
        p = mp.Process(target=worker_producer, args=(i, scan_ids_queue, data_queue))
        p.start()
        processes.append(p)

    # 3. GPU Consumer Loop
    global_patch_count = 0
    finished_workers = 0
    pbar = tqdm(total=total_scans, desc="Processing")
    
    while finished_workers < NUM_WORKERS:
        try:
            item = data_queue.get(timeout=1)
        except queue.Empty:
            continue

        if item is None:
            finished_workers += 1
            continue

        patient_id, ct_np, mask_np, current_spacing = item
        
        try:
            # Move to GPU
            ct_tensor = torch.from_numpy(ct_np).to(device, dtype=torch.float32)
            mask_tensor = torch.from_numpy(mask_np).to(device, dtype=torch.float32)

            # --- 1. Resample ---
            ct_res = gpu_resample(ct_tensor, current_spacing, TARGET_SPACING, 'trilinear')
            mask_res = gpu_resample(mask_tensor, current_spacing, TARGET_SPACING, 'nearest')
            
            # --- 2. Normalize & Window ---
            ct_norm = torch.clamp(ct_res, LUNG_WINDOW[0], LUNG_WINDOW[1])
            ct_norm = (ct_norm - LUNG_WINDOW[0]) / (LUNG_WINDOW[1] - LUNG_WINDOW[0])
            
            # --- 3. Pad if smaller than Patch Size ---
            shape = ct_norm.shape
            pad_z = max(0, CUBE_SIZE[0] - shape[0])
            pad_y = max(0, CUBE_SIZE[1] - shape[1])
            pad_x = max(0, CUBE_SIZE[2] - shape[2])
            
            if pad_z > 0 or pad_y > 0 or pad_x > 0:
                pad_args = (0, pad_x, 0, pad_y, 0, pad_z)
                ct_norm = F.pad(ct_norm, pad_args, value=0)
                mask_res = F.pad(mask_res, pad_args, value=0)

            # --- 4. Extract Patches ---
            shape = ct_norm.shape
            pos_patches = []
            neg_patches = []
            
            # Slide on CPU dimensions, slice on GPU tensors
            for z in range(0, shape[0] - CUBE_SIZE[0] + 1, STRIDE[0]):
                for y in range(0, shape[1] - CUBE_SIZE[1] + 1, STRIDE[1]):
                    for x in range(0, shape[2] - CUBE_SIZE[2] + 1, STRIDE[2]):
                        
                        img_gpu = ct_norm[z:z+CUBE_SIZE[0], y:y+CUBE_SIZE[1], x:x+CUBE_SIZE[2]]
                        mask_gpu = mask_res[z:z+CUBE_SIZE[0], y:y+CUBE_SIZE[1], x:x+CUBE_SIZE[2]]
                        
                        # FILTER: Skip Air
                        if torch.mean(img_gpu) < 0.02: continue
                        
                        # CLASSIFY: Pos vs Neg
                        is_pos = torch.sum(mask_gpu) > 0
                        
                        # DOWNLOAD: Move only valid patches to CPU
                        patch_tuple = (img_gpu.cpu().numpy(), mask_gpu.cpu().numpy())
                        
                        if is_pos: pos_patches.append(patch_tuple)
                        else: neg_patches.append(patch_tuple)

            # --- 5. Smart Balancing ---
            final_patches = pos_patches # Always keep positives
            
            # Keep 2 negatives for every 1 positive
            # Or keep 5 randoms if the scan is empty (healthy patient)
            n_keep = max(5, len(pos_patches)*2)
            
            if len(neg_patches) > n_keep:
                random.shuffle(neg_patches)
                final_patches.extend(neg_patches[:n_keep])
            else:
                final_patches.extend(neg_patches)

            # --- 6. Save to Disk ---
            for img, mask in final_patches:
                pid = f"{patient_id}_{global_patch_count:05d}"
                
                # Add Channel Dim (1, D, H, W)
                np.save(os.path.join(IMG_DIR, f"{pid}.npy"), np.expand_dims(img, 0))
                np.save(os.path.join(MASK_DIR, f"{pid}.npy"), np.expand_dims(mask, 0))
                
                global_patch_count += 1
            
            # Cleanup VRAM
            del ct_tensor, mask_tensor, ct_res, mask_res, ct_norm
            pbar.update(1)

        except Exception as e:
            # print(f"Error processing {patient_id}: {e}")
            pass

    pbar.close()
    for p in processes: p.join()
    print(f"\n--- Done! Total Patches Saved: {global_patch_count} ---")

