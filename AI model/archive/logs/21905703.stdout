import os
import torch
import numpy as np
from monai.data import DataLoader, CacheDataset, load_decathlon_datalist, list_data_collate
from monai.losses import DiceFocalLoss
from monai.metrics import compute_dice
from monai.inferers import sliding_window_inference
from monai.utils import set_determinism
from monai.apps.vista3d.sampler import sample_prompt_pairs
from monai.transforms import Activations, AsDiscrete
from torch.optim.lr_scheduler import CosineAnnealingLR 
import config as cfg
from dataset import get_transforms
from model import get_vista_model
from monai.optimizers import WarmupCosineSchedule
from tqdm import tqdm

def flatten_collate(batch):
    flattened_data = [item for sublist in batch for item in sublist]
    return list_data_collate(flattened_data)

def main():
    set_determinism(seed=0)
    os.makedirs(cfg.LOG_DIR, exist_ok=True)
    device = torch.device("cuda:0")
    print(f"VISTA-3D Finetuning on {device} | Spacing: {cfg.TARGET_SPACING}")

    # 1. Load Data
    train_files = load_decathlon_datalist(cfg.JSON_PATH, True, "training")
    val_files = load_decathlon_datalist(cfg.JSON_PATH, True, "validation")

    train_ds = CacheDataset(
        data=train_files, 
        transform=get_transforms("train"), 
        cache_rate=1.0, 
        num_workers=cfg.NUM_WORKERS
    )
    
    # Logic: If Batch Size is 16 and we take 4 crops per image, we load 4 images.
    num_samples = 2
    loader_batch_size = max(1, cfg.BATCH_SIZE // num_samples) 
    
    train_loader = DataLoader(
        train_ds, 
        batch_size=loader_batch_size, 
        shuffle=True, 
        num_workers=cfg.NUM_WORKERS, 
        collate_fn=flatten_collate, 
        pin_memory=True
    )

    val_ds = CacheDataset(
        data=val_files, 
        transform=get_transforms("val"), 
        cache_rate=1.0, 
        num_workers=cfg.NUM_WORKERS
    )
    val_loader = DataLoader(val_ds, batch_size=1, num_workers=cfg.NUM_WORKERS)

    # 2. Initialize Model
    model = get_vista_model(load_weights=True).to(device)
    
    # 3. Optimization
    # SOTA Loss for small objects (Squared Pred = True is crucial for stability)
    loss_function = DiceFocalLoss(
        to_onehot_y=False, 
        sigmoid=True, 
        lambda_dice=1.0, 
        lambda_focal=1.0,
        squared_pred=True 
    )
    optimizer = torch.optim.AdamW(model.parameters(), lr=cfg.LR, weight_decay=1e-5)
    
    # [FIX] Calculate steps based on LOADER length (batches), not inner loop (images)
    total_steps = cfg.MAX_EPOCHS * len(train_loader)
    warmup_steps = int(0.05 * total_steps)
    
    scheduler = WarmupCosineSchedule(
        optimizer=optimizer,
        warmup_steps=warmup_steps,
        t_total=total_steps,
        end_lr=1e-7, 
        warmup_multiplier=0.1
    )
    
    scaler = torch.amp.GradScaler('cuda') 

    # 4. Training Loop
    best_metric = -1
    best_metric_epoch = -1

    for epoch in range(cfg.MAX_EPOCHS):
        model.train()
        epoch_loss = 0
        step = 0
        
        epoch_skipped = 0
        epoch_total_crops = 0
        
        # [FIX] Zero gradients before starting the loader loop
        optimizer.zero_grad()
        
        for batch_data in train_loader:
            step += 1
            inputs = batch_data["image"].to(device)
            labels = batch_data["label"].to(device)
            
            # [FIX] Gradient Accumulation Setup
            # We process images one by one but update weights once per batch.
            current_batch_size = inputs.shape[0]
            batch_loss_accum = 0.0
            
            for i in range(current_batch_size):
                curr_img = inputs[[i]]
                curr_lbl = labels[[i]]
                
                label_prompt, point, point_label, prompt_class = sample_prompt_pairs(
                    curr_lbl,
                    cfg.LABEL_SET,
                    max_point=cfg.MAX_POINT,
                    max_prompt=cfg.MAX_PROMPT,
                    max_backprompt=cfg.MAX_BACKPROMPT,
                    max_foreprompt=None,
                    drop_label_prob=cfg.DROP_LABEL_PROB,
                    drop_point_prob=cfg.DROP_POINT_PROB,
                )

                epoch_total_crops += 1
                if prompt_class is None: 
                    epoch_skipped += 1
                    continue

                with torch.amp.autocast('cuda'):
                    outputs = model(
                        input_images=curr_img,
                        point_coords=point,
                        point_labels=point_label,
                        class_vector=label_prompt
                    )
                    
                    loss = torch.tensor(0.0, device=device)
                    loss_n = torch.tensor(0.0, device=device)
                    
                    for idx in range(len(prompt_class)):
                        # Create binary target (0 or 1) and cast to Float
                        target_binary = (curr_lbl == prompt_class[idx]).float()
                        
                        loss += loss_function(
                            outputs[[idx]].float(), 
                            target_binary
                        )
                        loss_n += 1.0
                    
                    # Normalize by number of prompts in this specific image
                    loss = loss / torch.max(loss_n, torch.tensor(1.0, device=device))
                    
                    # [FIX] Normalize by BATCH SIZE for accumulation
                    # This ensures the gradient magnitude is averaged over the 4 images
                    loss = loss / current_batch_size

                # [FIX] Accumulate gradients (Backward), but do NOT step optimizer yet
                scaler.scale(loss).backward()
                
                # Recover true loss magnitude for logging
                batch_loss_accum += loss.item() * current_batch_size

            # [FIX] Optimizer Step (Once per Loader Batch)
            # This makes "Effective Batch Size" == 4 (or whatever is in config)
            scaler.unscale_(optimizer)
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
            
            scaler.step(optimizer)
            scaler.update()
            
            # [FIX] Scheduler Step (Once per Loader Batch)
            scheduler.step()
            
            # [FIX] Zero Grads for the NEXT batch
            optimizer.zero_grad()
            
            epoch_loss += batch_loss_accum / current_batch_size
            
            if step % 10 == 0:
                current_lr = optimizer.param_groups[0]['lr']
                print(f"Ep {epoch+1}/{cfg.MAX_EPOCHS} Step {step}/{len(train_loader)} Loss: {batch_loss_accum/current_batch_size:.4f} LR: {current_lr:.2e}", end="\r")

        print(f"\nEpoch {epoch+1} Avg Loss: {epoch_loss/step:.4f}")

        skip_rate = (epoch_skipped / epoch_total_crops) * 100 if epoch_total_crops > 0 else 0
        print(f"Epoch {epoch+1} Avg Loss: {epoch_loss/step:.4f} | Skip Rate: {skip_rate:.1f}% ({epoch_skipped}/{epoch_total_crops})")

        # 5. Validation
        if (epoch + 1) % cfg.VAL_INTERVAL == 0:
            model.eval()
            dice_scores = []
            val_prompt = torch.tensor([23], device=device)

            post_sigmoid = Activations(sigmoid=True)
            post_pred = AsDiscrete(threshold=0.5)
            
            val_bar = tqdm(
                val_loader, 
                desc=f"Validating Ep {epoch+1}", 
                leave=False, 
                dynamic_ncols=True
            )
            
            with torch.no_grad():
                for i, val_data in enumerate(val_bar):
                    val_img = val_data["image"].to(device)
                    val_lbl = val_data["label"].to(device)
                    
                    val_bar.set_postfix({"Batch": f"{i+1}/{len(val_loader)}", "Shape": list(val_img.shape[2:])})

                    with torch.amp.autocast('cuda'):
                        val_out = sliding_window_inference(
                            val_img, cfg.ROI_SIZE, 16, model, 
                            overlap=0.5, transpose=True, class_vector=val_prompt, device=device
                        )
                    
                    val_pred = post_sigmoid(val_out)
                    val_mask = post_pred(val_pred)
                    
                    target_binary = (val_lbl == 23).float()
                    
                    if i == 0:
                        print(f"[DEBUG Ep{epoch+1}] Max Pred: {val_pred.max():.4f}, Max GT: {target_binary.max()}")
                        print(f"[DEBUG Ep{epoch+1}] Pred Shape: {val_mask.shape}, GT Shape: {target_binary.shape}")

                    dice = compute_dice(
                        y_pred=val_mask, 
                        y=target_binary, 
                        include_background=False
                    )
                    
                    if target_binary.sum() == 0:
                        dice_scores.append(1.0 if val_mask.sum() == 0 else 0.0)
                    else:
                        dice_scores.append(dice.item())

            mean_dice = np.mean(dice_scores)
            current_lr = scheduler.get_last_lr()[0]
            print(f"Validation Dice (Lung Tumor): {mean_dice:.4f} | LR: {current_lr:.8f}")
            
            if mean_dice > best_metric:
                best_metric = mean_dice
                best_metric_epoch = epoch + 1
                torch.save(model.state_dict(), os.path.join(cfg.LOG_DIR, "best_model.pth"))
                print(">>> New Best Model Saved!")

if __name__ == "__main__":
    main()======================================================

import os
import torch
import numpy as np
from tqdm import tqdm
from monai.inferers import sliding_window_inference
from monai.apps.vista3d.transforms import VistaPostTransformd
from monai.metrics import DiceMetric, HausdorffDistanceMetric

import config as cfg
from dataset import get_dataloaders
from model import get_model

def evaluate():
    device = torch.device("cuda")
    print("--- Starting Evaluation ---")
    
    _, val_loader = get_dataloaders()
    model = get_model(load_weights=False)
    
    best_model_path = os.path.join(cfg.CHECKPOINT_DIR, "best_metric_model.pth")
    if not os.path.exists(best_model_path):
        print(f"ERROR: Model not found at {best_model_path}")
        return

    model.load_state_dict(torch.load(best_model_path, weights_only=True))
    model.to(device)
    model.eval()
    
    dice_metric_calc = DiceMetric(include_background=False, reduction="mean")
    hd95_metric_calc = HausdorffDistanceMetric(include_background=False, percentile=95, reduction="mean")
    
    dice_scores = []
    hd95_scores = []

    with torch.no_grad():
        for val_data in tqdm(val_loader, desc="Evaluating"):
            val_images = val_data["image"].to(device)
            val_labels = val_data["label"].to(device)
            
            val_outputs = sliding_window_inference(
                val_images,
                cfg.INPUT_SHAPE,
                4, 
                model,
                transpose=True,
                class_vector=torch.tensor(cfg.LABEL_SET[1:], device=device),
                overlap=0.5
            )
            
            # --- CRITICAL FIX ---
            # Use val_outputs[0]
            post_pred_single = VistaPostTransformd(keys="pred")(
                {"pred": val_outputs[0], "label_prompt": torch.tensor(cfg.LABEL_SET[1:], device=device)}
            )["pred"]
            
            # Expand dims back to (1, D, H, W) for metrics
            pred_binary = (post_pred_single == cfg.TARGET_VISTA_CLASS).float().unsqueeze(0)
            gt_binary = (val_labels == cfg.TARGET_VISTA_CLASS).float()
            
            if gt_binary.sum() > 0:
                dice = dice_metric_calc(y_pred=pred_binary, y=gt_binary)
                hd95 = hd95_metric_calc(y_pred=pred_binary, y=gt_binary)
                
                dice_scores.append(dice.item())
                hd95_scores.append(hd95.item())
            
            dice_metric_calc.reset()
            hd95_metric_calc.reset()

    print("=======================================")
    print(f"FINAL RESULTS (Lung Tumor / Class 23)")
    print("=======================================")
    print(f"Mean Dice: {np.nanmean(dice_scores):.4f}")
    print(f"Mean HD95: {np.nanmean(hd95_scores):.4f} mm")
    print("=======================================")

if __name__ == "__main__":
    evaluate()import torch
import numpy as np
from monai.transforms import (
    Compose,
    LoadImaged,
    EnsureChannelFirstd,
    Orientationd,
    Spacingd,
    ScaleIntensityRanged,
    RandCropByPosNegLabeld,
    RandAffined,
    RandGaussianNoised,
    RandFlipd,
    RandRotate90d,
    EnsureTyped
)
from monai.apps.vista3d.transforms import Relabeld
import config as cfg

def get_transforms(mode="train"):
    transforms = [
        LoadImaged(keys=["image", "label"]),
        EnsureChannelFirstd(keys=["image", "label"]),
        Orientationd(keys=["image", "label"], axcodes="RAS"),
        # Official VISTA spacing
        Spacingd(
            keys=["image", "label"], 
            pixdim=cfg.TARGET_SPACING, 
            mode=("bilinear", "nearest")
        ),
        # Official VISTA Intensity Range (Foundation Model Alignment)
        ScaleIntensityRanged(
            keys=["image"],
            a_min=cfg.INTENSITY_RANGE[0],
            a_max=cfg.INTENSITY_RANGE[1],
            b_min=0.0,
            b_max=1.0,
            clip=True,
        ),
        # Map LIDC(1) -> VISTA(23)
        Relabeld(keys="label", label_mappings=cfg.LABEL_MAPPINGS, dtype=torch.uint8),
    ]

    if mode == "train":
        transforms += [
            # Dynamic Cropping for Small Nodules
            RandCropByPosNegLabeld(
                keys=["image", "label"],
                label_key="label",
                spatial_size=cfg.ROI_SIZE,
                pos=2,
                neg=1,
                num_samples=2,
                image_key="image",
                image_threshold=0,
            ),
            RandFlipd(keys=["image", "label"], prob=0.5, spatial_axis=0),
            RandFlipd(keys=["image", "label"], prob=0.5, spatial_axis=1),
            RandFlipd(keys=["image", "label"], prob=0.5, spatial_axis=2),
            RandRotate90d(keys=["image", "label"], prob=0.5, max_k=3),
            RandGaussianNoised(keys=["image"], prob=0.1, mean=0.0, std=0.1),
            RandAffined(
                keys=['image', 'label'],
                mode=('bilinear', 'nearest'),
                prob=0.3,
                spatial_size=cfg.ROI_SIZE,
                rotate_range=(0, 0, np.pi/15),
                scale_range=(0.1, 0.1, 0.1)
            )
        ]

    return Compose(transforms + [EnsureTyped(keys=["image", "label"])])import os
import json
import numpy as np
import pylidc as pl
import nibabel as nib
from tqdm import tqdm
from pylidc.utils import consensus  # <--- FIXED IMPORT
import config as cfg

# --- CRITICAL: PYLIDC MONKEY PATCH ---
import numpy
if not hasattr(numpy, 'int'): numpy.int = int
if not hasattr(numpy, 'float'): numpy.float = float
if not hasattr(numpy, 'bool'): numpy.bool = bool

def get_affine_from_scan(scan):
    """
    Constructs a valid affine matrix preserving Spacing AND Origin.
    """
    try:
        first_slice = scan.images[0]
        spacings = [scan.pixel_spacing, scan.pixel_spacing, scan.slice_spacing]
        origin = first_slice.ImagePositionPatient
        
        affine = np.eye(4)
        affine[0, 0] = spacings[0]
        affine[1, 1] = spacings[1]
        affine[2, 2] = spacings[2]
        
        affine[0, 3] = origin[0]
        affine[1, 3] = origin[1]
        affine[2, 3] = origin[2]
        
        return affine
    except Exception as e:
        # Fallback if DICOM header is missing info
        spacing = np.array([scan.pixel_spacing, scan.pixel_spacing, scan.slice_spacing]).flatten()
        affine = np.eye(4)
        affine[0, 0] = spacing[0]
        affine[1, 1] = spacing[1]
        affine[2, 2] = spacing[2]
        return affine

def preprocess_lidc_sota():
    os.makedirs(os.path.join(cfg.DATA_ROOT, "images"), exist_ok=True)
    os.makedirs(os.path.join(cfg.DATA_ROOT, "labels"), exist_ok=True)

    print("Querying LIDC-IDRI database...")
    scans = pl.query(pl.Scan).all()
    print(f"Found {len(scans)} scans.")

    valid_entries = []

    # Iterate with index to catch problematic files easily
    for scan in tqdm(scans, desc="Processing LIDC"):
        try:
            # 1. Check for Annotations
            cluster_annotations = scan.cluster_annotations()
            
            if not cluster_annotations:
                continue

            # 2. Reconstruct Volume (HU)
            vol = scan.to_volume(verbose=False)
            mask = np.zeros(vol.shape, dtype=np.uint8)
            v_shape = vol.shape
            
            has_valid_nodule = False

            for cluster in cluster_annotations:
                # 50% Consensus level
                # Fixed: Calling consensus from pylidc.utils
                # Pad is [(before, after), ...] tuples. 0 padding ensures we stick to the bbox.
                cmask, cbbox, _ = consensus(cluster, clevel=0.5, pad=[(0,0), (0,0), (0,0)])
                
                # --- BOUNDARY LOGIC ---
                b_start = [cbbox[0].start, cbbox[1].start, cbbox[2].start]
                b_stop  = [cbbox[0].stop,  cbbox[1].stop,  cbbox[2].stop]

                # Volume Slices (Clamp to volume limits)
                vol_slice = tuple(
                    slice(max(0, s), min(d, e)) 
                    for s, e, d in zip(b_start, b_stop, v_shape)
                )

                # Mask Slices (Handle cases where bbox starts before 0)
                mask_slice = tuple(
                    slice(max(0, -s), max(0, -s) + (min(d, e) - max(0, s)))
                    for s, e, d in zip(b_start, b_stop, v_shape)
                )
                
                try:
                    # Merge Logic
                    if mask[vol_slice].shape == cmask[mask_slice].shape:
                        combined = np.logical_or(mask[vol_slice], cmask[mask_slice])
                        mask[vol_slice] = combined.astype(np.uint8)
                        has_valid_nodule = True
                except Exception:
                    continue

            if not has_valid_nodule:
                continue

            # 3. Construct Affine
            affine = get_affine_from_scan(scan)

            # 4. Save NIfTI
            series_uid = scan.series_instance_uid.replace('.', '')[-10:]
            file_id = f"{scan.patient_id}_{series_uid}"
            
            img_path = os.path.join(cfg.DATA_ROOT, "images", f"{file_id}_image.nii.gz")
            lbl_path = os.path.join(cfg.DATA_ROOT, "labels", f"{file_id}_label.nii.gz")

            nib.save(nib.Nifti1Image(vol.astype(np.float32), affine), img_path)
            nib.save(nib.Nifti1Image(mask.astype(np.uint8), affine), lbl_path)

            valid_entries.append({
                "image": img_path,
                "label": lbl_path,
                "patient_id": scan.patient_id
            })

        except Exception as e:
            print(f"!!! ERROR on scan {scan.patient_id}: {e}")
            continue

    # 5. Patient-Level Splitting
    unique_patients = sorted(list(set(d['patient_id'] for d in valid_entries)))
    rng = np.random.RandomState(42)
    rng.shuffle(unique_patients)
    
    split_idx = int(len(unique_patients) * 0.8)
    train_patients = set(unique_patients[:split_idx])
    val_patients = set(unique_patients[split_idx:])
    
    final_train = [d for d in valid_entries if d['patient_id'] in train_patients]
    final_val = [d for d in valid_entries if d['patient_id'] in val_patients]
    
    # Remove metadata before saving JSON
    for d in final_train: del d['patient_id']
    for d in final_val: del d['patient_id']

    json_output = {
        "training": final_train,
        "validation": final_val
    }

    with open(cfg.JSON_PATH, "w") as f:
        json.dump(json_output, f, indent=4)

    print(f"Done. Train: {len(final_train)}, Val: {len(final_val)}")

if __name__ == "__main__":
    preprocess_lidc_sota()We used this for preprocessing:
