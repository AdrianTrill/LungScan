{
  "name": "lungscan-frontend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "next dev",
    "dev:browser": "NEXT_PUBLIC_RUNTIME=browser node scripts/copy-assets.mjs && NEXT_PUBLIC_RUNTIME=browser next dev",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "next build",
    "build:browser": "NEXT_PUBLIC_RUNTIME=browser node scripts/copy-assets.mjs && NEXT_PUBLIC_RUNTIME=browser next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "ui-check": "node scripts/ui-check.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "onnxruntime-web": "1.31.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "^2.6.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "fake-indexeddb": "^6.2.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "puppeteer-core": "25.17.0",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.3"
  }
}
